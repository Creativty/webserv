        "            align-items: center;\n"
        "            height: 100vh;\n"
        "            margin: 0;\n"
        "            background-color: #f4f4f4;\n"
        "        }\n"
        "        .container {\n"
        "            text-align: center;\n"
        "            padding: 50px;\n"
        "            border-radius: 10px;\n"
        "            background-color: #ffffff;\n"
        "            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n"
        "        }\n"
        "        h1 {\n"
